# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SISTEMA DE NOTIFICACIONES AUTOMÁTICAS POR CORREO ELECTRÓNICO (PINTUCO COLORLINK)
# ==============================================================================
# Proveedor principal y exclusivo: Google Apps Script Webhook (POST seguro)
# Las notificaciones se despachan a través del backend (/api/notifications/*)
# garantizando que MAIL_SECRET nunca se exponga en URLs ni en el frontend del cliente.
# ==============================================================================

# URL Webhook de tu Google Apps Script implementado como Aplicación Web (termina en /exec)
GOOGLE_APPS_SCRIPT_URL=""

# Clave secreta enviada en el cuerpo POST para autorizar las solicitudes
MAIL_SECRET=""

# Correo del Administrador para recibir alertas internas de nuevos registros y compras
ADMIN_EMAIL="salgadoarevaloleidy@gmail.com"

# ==============================================================================
# BASE DE DATOS SUPABASE (PERSISTENCIA RELACIONAL)
